# Copy to .env and fill in for your CAM host. Never commit the real .env.
# Most values have defaults inside docker-compose.yml; this file names the
# knobs so an operator knows what's tunable.

# Public hostname/IP used in Grafana iframe URLs the browser will fetch.
# When set, the panel emits absolute iframe URLs against this host instead
# of "localhost:3001". Required when accessing the panel from another machine.
CAM_PUBLIC_HOST=<cam-host>

# CAM's existing InfluxDB (started at <cam-host>:8086 by
# deploy/cam-host/docker-compose.yml). The demo panel writes per-handshake
# samples there and its Grafana reads from it. Use the same token as
# INFLUX_TOKEN in deploy/cam-host/.env; leave empty to disable writes.
INFLUX_URL=http://host.docker.internal:8086
INFLUX_ORG=pqreact
INFLUX_BUCKET=NUC_metrics
INFLUX_TOKEN=CHANGE_ME

# Grafana `admin` password — required. Only matters for the few dashboard
# tweaks an operator wants to make in the UI; anonymous Viewer is enabled
# regardless.
GRAFANA_ADMIN_PASSWORD=CHANGE_ME

# Optional: mirror run summaries into the PQ-REACT MCP MariaDB
# (PQREACT.performance_test) so the MCP / LLM chat can see the panel's data.
# Leave MARIADB_HOST empty to disable.
MARIADB_HOST=
MARIADB_PORT=3307
MARIADB_USER=pqreact
MARIADB_PASSWORD=CHANGE_ME
MARIADB_NAME=PQREACT
# Tag for CAM-originated rows — the chat advisor SQL filters on this string.
CAM_SOURCE_TAG=cam-context-agility

# Optional: when set, the panel can also fan out to the remote QUJATA stack
# instead of the local containers. Kept off by default — this stack IS the
# local backup, the QUJATA stack is the primary.
# QUJATA_API_BASE=http://<qujata-api-host>:3020/qujata-api
