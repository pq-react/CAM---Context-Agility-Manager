# Copy to .env (same directory as docker-compose.yml) and fill in.
# Never commit the real .env.

# InfluxDB initial admin user (only used on first start of an empty volume).
INFLUX_USERNAME=pqreact
INFLUX_PASSWORD=CHANGE_ME

# Admin API token. Generate one with:  openssl rand -hex 32
# The same token must be given to the demo panel
# (pqreact_hooks/cam_demo_panel/.env -> INFLUX_TOKEN).
INFLUX_TOKEN=CHANGE_ME

INFLUX_ORG=pqreact
INFLUX_BUCKET=NUC_metrics
INFLUX_RETENTION=168h

# Telegraf runs with network_mode: host, so localhost:8086 reaches InfluxDB.
TELEGRAF_INFLUX_URL=http://localhost:8086
# Value of the `host` tag on every metric.
TELEGRAF_HOSTNAME=pqreact-CAM
